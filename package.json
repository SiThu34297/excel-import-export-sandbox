{
  "name": "excel-import-export-sandbox",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"public/**/*.html\" \"scripts/**/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"public/**/*.html\" \"scripts/**/*.cjs\"",
    "examples:generate": "node scripts/generate-examples.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/unzipper": "^0.10.11",
    "prettier": "^3.8.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
